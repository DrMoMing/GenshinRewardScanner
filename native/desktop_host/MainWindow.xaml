              </StackPanel>
            </Border>

            <Grid x:Name="SpaceGrid" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SpaceBatchColumn" Width="1.52*"/><ColumnDefinition x:Name="SpaceSideColumn" Width="0.95*"/></Grid.ColumnDefinitions>
              <Border x:Name="BatchPanel" Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,6,0" VerticalAlignment="Top">
                <StackPanel>
                  <Grid><StackPanel><TextBlock Text="手动按批选择" Style="{StaticResource KickerText}"/><TextBlock Text="截图与诊断批次" Style="{StaticResource H2Text}" Margin="0,2,0,0"/></StackPanel><Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="5" Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Top"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconTarget}" Style="{StaticResource IconStyle}" Width="11" Height="11" Stroke="{DynamicResource MutedBrush}"/><TextBlock Text="默认手动清理" FontSize="8" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,0"/></StackPanel></Border></Grid>
                  <Grid Margin="0,10,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="FilterAll" Style="{StaticResource FilterButton}" Content="全部 0"/><Button x:Name="FilterCleanable" Style="{StaticResource FilterButton}" Content="可清理 0" Margin="3,0,0,0"/><Button x:Name="FilterProtected" Style="{StaticResource FilterButton}" Content="受保护 0" Margin="3,0,0,0"/><Button x:Name="FilterConvert" Style="{StaticResource FilterButton}" Content="产物JSON" Margin="3,0,0,0"/></StackPanel><Button x:Name="SelectAllCleanable" Style="{StaticResource TextButton}" Content="全选可清理" HorizontalAlignment="Right"/></Grid>

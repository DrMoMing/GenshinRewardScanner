        <ScrollViewer x:Name="PageSpace" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,24">
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Border Width="20" Height="1" Background="{DynamicResource BrandBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="产出与存储" Style="{StaticResource KickerText}"/></StackPanel><TextBlock x:Name="SpacePageTitle" Text="产出 / 空间管理" Style="{StaticResource H1Text}" Margin="0,5,0,2"/><TextBlock Text="按扫描批次手动清理；确认范围后再执行。保护内容不会进入清理列表。" Style="{StaticResource BodyText}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Border x:Name="SpaceUpdateNotice" Visibility="Collapsed" Background="#FFF2C6" CornerRadius="6" Padding="10,8" Margin="0,0,10,0" MaxWidth="280"><TextBlock Text="有新记录更新，请刷新空间以应用新内容" Foreground="#896218" TextWrapping="Wrap"/></Border><TextBlock x:Name="SpaceRefreshProgress" Text="正在刷新…" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,10,0"/><Button x:Name="RefreshSpace" Style="{StaticResource QuietButton}" VerticalAlignment="Top"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconStyle}" Width="13" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="刷新空间" Margin="5,0,0,0"/></StackPanel></Button></StackPanel></Grid>

            <Border x:Name="SpaceSummaryPanel" Style="{StaticResource PanelStyle}" Margin="0,16,0,0">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel x:Name="SpacePathArea" Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="输出数据目录" Style="{StaticResource KickerText}"/><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Grid.Column="0" Data="{StaticResource IconFolder}" Style="{StaticResource IconStyle}" Width="15" Height="15" VerticalAlignment="Top" Margin="0,2,0,0" Stroke="{DynamicResource BrandBrush}"/><TextBlock x:Name="SpacePathText" Grid.Column="1" Text="{Binding Space.Path}" FontSize="13" FontWeight="SemiBold" Margin="6,0,0,0" TextWrapping="Wrap"/></Grid></StackPanel><StackPanel x:Name="SpaceKpiArea" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><StackPanel Margin="0,0,18,0"><TextBlock Text="已使用" FontSize="8.5" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Space.Used}" FontSize="16" FontWeight="SemiBold"/></StackPanel><StackPanel Margin="0,0,18,0"><TextBlock Text="可清理批次" FontSize="8.5" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Space.Cleanable}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrandBrush}"/></StackPanel><StackPanel Margin="0,0,18,0"><TextBlock Text="受保护" FontSize="8.5" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Space.Protected}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/></StackPanel><StackPanel x:Name="SpaceFreeKpi"><TextBlock Text="磁盘可用" FontSize="8.5" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Space.Free}" FontSize="16" FontWeight="SemiBold"/></StackPanel></StackPanel></Grid>
                <Grid Margin="0,12,0,0"><TextBlock Text="已用空间构成" FontSize="8.5" Foreground="{DynamicResource MutedBrush}"/><Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="4" Padding="5,1" HorizontalAlignment="Right"><TextBlock Text="本地统计" FontSize="8" Foreground="{DynamicResource MutedBrush}"/></Border></Grid>

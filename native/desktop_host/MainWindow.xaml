                <Border x:Name="TutTasksArticle" Style="{StaticResource PanelTightStyle}" Margin="0,0,0,7"><StackPanel><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource BrandSoftBrush}" CornerRadius="4" Padding="5,1"><TextBlock Text="03" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrandBrush}"/></Border><TextBlock Text="三种扫描任务" Style="{StaticResource H3Text}" Margin="7,0,0,0"/></StackPanel><TextBlock Text="整趟扫描：适用于圣遗物副本，按所选星级录入详情。单卡识别：只读取当前打开的圣遗物详情。横排拼图：保存完整横排，开启“横排读字”后同时识别文字。周本或 40 体力首领的奖励混有其他产物时，请先做横排拼图，再逐个打开要录入的圣遗物详情，手动对每一张用单卡识别补录。" Style="{StaticResource SmallText}" Foreground="#43515D" Margin="0,5,0,0"/><TextBlock Text="星级筛选支持多选，至少保留一项。请求路数会在启动时根据内存预算调整，状态区同时显示“请求 / 实际”。" Style="{StaticResource SmallText}" Foreground="#43515D" Margin="0,4,0,0"/></StackPanel></Border>
                <Border x:Name="TutExcelArticle" Style="{StaticResource PanelTightStyle}" Margin="0,0,0,7"><StackPanel><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource BrandSoftBrush}" CornerRadius="4" Padding="5,1"><TextBlock Text="04" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrandBrush}"/></Border><TextBlock Text="Excel 会写入什么" Style="{StaticResource H3Text}" Margin="7,0,0,0"/></StackPanel><TextBlock Text="识别结果在识别完成后逐件追加到工作簿，保留先前记录；任务记录另行保存开始与结束状态。写入失败时按界面提示检查目标路径、只读状态、占用实例或连接错误，已保存的截图与格式化 JSON 可用于核对。" Style="{StaticResource SmallText}" Foreground="#43515D" Margin="0,5,0,0"/><TextBlock Text="任务完成并回到待命后，可以在表尾填写自定义内容，也可以在两趟任务的记录之间插入备注行。下次扫描会在最后一行有内容的位置后追加。扫描器会为新写入的区域覆盖相关格式，其余格式会被保留。使用文件模式时，手动修改并保存后，请重新连接工作簿。" Style="{StaticResource SmallText}" Foreground="#43515D" Margin="0,4,0,0"/></StackPanel></Border>
                <Border x:Name="TutControlArticle" Style="{StaticResource PanelTightStyle}" Margin="0,0,0,7"><StackPanel><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource BrandSoftBrush}" CornerRadius="4" Padding="5,1"><TextBlock Text="05" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrandBrush}"/></Border><TextBlock Text="快捷键、中止与停止监听" Style="{StaticResource H3Text}" Margin="7,0,0,0"/></StackPanel><TextBlock Text="中止当前任务：完成当前输入动作并释放鼠标后停止本任务；快捷键监听与已加载模型保留，可直接开始下一次任务。停止监听：停止接收任务快捷键，不会退出应用。运行中的任务应先中止，再停止监听。" Style="{StaticResource SmallText}" Foreground="#43515D" Margin="0,5,0,0"/><TextBlock Text="六组快捷键可在设置页修改，应用打开时会尝试注册。发现冲突时，主页和浮窗会提醒，设置页会在对应快捷键旁显示“注册失败”。" Style="{StaticResource SmallText}" Foreground="#43515D" Margin="0,4,0,0"/></StackPanel></Border>
                <Border x:Name="TutOverlayArticle" Style="{StaticResource PanelTightStyle}" Margin="0,0,0,7"><StackPanel><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource BrandSoftBrush}" CornerRadius="4" Padding="5,1"><TextBlock Text="06" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrandBrush}"/></Border><TextBlock Text="浮窗与性能显示" Style="{StaticResource H3Text}" Margin="7,0,0,0"/></StackPanel><TextBlock Text="浮窗可拖动、缩放，背景不透明度可调，文字保持不透明。锁定后鼠标点击穿透到游戏；任务期间可临时自动锁定，结束后恢复原来的锁定状态。解锁操作不会主动激活浮窗。" Style="{StaticResource SmallText}" Foreground="#43515D" Margin="0,5,0,0"/><TextBlock Text="CPU、GPU、内存可整组显示，数值分为“应用”和“系统”。应用侧表示扫描器进程树占用，系统侧表示整机比例；采样间隔为两秒。" Style="{StaticResource SmallText}" Foreground="#43515D" Margin="0,4,0,0"/></StackPanel></Border>
                <Border x:Name="TutSoundArticle" Style="{StaticResource PanelTightStyle}" Margin="0,0,0,7"><StackPanel>
                  <StackPanel Orientation="Horizontal"><Border Background="{DynamicResource BrandSoftBrush}" CornerRadius="4" Padding="5,1"><TextBlock Text="07" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrandBrush}"/></Border><TextBlock Text="更换提示音" Style="{StaticResource H3Text}" Margin="7,0,0,0"/></StackPanel>
                  <TextBlock Text="进入「设置→提示音」，点击「打开提示音文件夹」。将音频文件放入，格式仅支持MP3和wav。只放想替换的文件即可。没放的会使用内置默认合成音。" Style="{StaticResource SmallText}" Foreground="#43515D" Margin="0,5,0,0"/>
                  <TextBlock Text="文件必须使用如下文件名（包含扩展名）：" Style="{StaticResource SmallText}" Foreground="#43515D" Margin="0,4,0,0"/>
                  <TextBlock Text="截图成功用 截图.wav 或 截图.mp3 ；任务成功用 成功.wav 或 成功.mp3 ；任务失败用 失败.wav 或 失败.mp3；指令未接收用 未接收.wav 或 未接收.mp3。" Style="{StaticResource SmallText}" Foreground="#43515D" Margin="0,4,0,0"/>
                  <TextBlock Text="每段最多3秒；WAV用单声道或双声道的8或16位PCM。文件同名时优先WAV。替换或删除文件后重启扫描器，再用「试听」确认。" Style="{StaticResource SmallText}" Foreground="#43515D" Margin="0,4,0,0"/>
                </StackPanel></Border>
                <Border x:Name="TutSpaceArticle" Style="{StaticResource PanelTightStyle}" Margin="0,0,0,7"><StackPanel><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource BrandSoftBrush}" CornerRadius="4" Padding="5,1"><TextBlock Text="08" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrandBrush}"/></Border><TextBlock Text="输出查找与空间清理" Style="{StaticResource H3Text}" Margin="7,0,0,0"/></StackPanel><TextBlock Text="工作簿、格式化 JSON、学习成果和截图批次分别存放。空间管理默认手动按批选择；清理前会展示批次、容量与保护范围，确认后才执行。可打开批次所在位置，也可在“产物 JSON”页签导出 JSON 或转 Excel。多选批次时只需选择一次导出目录。自动清理可勾选图片、结果 JSON、日志与诊断，未勾选的资料会保留。Excel、学习库及仍在处理的资料受到保护。" Style="{StaticResource SmallText}" Foreground="#43515D" Margin="0,5,0,0"/></StackPanel></Border>
                <Border x:Name="TutFaqArticle" Style="{StaticResource PanelTightStyle}"><StackPanel><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource BrandSoftBrush}" CornerRadius="4" Padding="5,1"><TextBlock Text="09" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrandBrush}"/></Border><TextBlock Text="常见失败" Style="{StaticResource H3Text}" Margin="7,0,0,0"/></StackPanel><TextBlock Text="找不到游戏窗口：确认游戏已启动，刷新后核对捕获窗口名称与尺寸。无法写入工作簿：查看具体错误，核对所选路径、只读或锁定状态及 Excel 连接。快捷键没有响应：确认当前处于“等待快捷键”，并到设置页查看是否有注册失败的快捷键。主页或浮窗出现分辨率偏低提示时，识别可能不稳定，建议将游戏捕获分辨率调到 1920×1080 或更高。" Style="{StaticResource SmallText}" Foreground="#43515D" Margin="0,5,0,0"/></StackPanel></Border>
              </StackPanel>
            </Grid>

            <Border x:Name="LicensePanel" Style="{StaticResource PanelStyle}" Visibility="Collapsed" Margin="0,8,0,0">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Border Width="36" Height="36" Background="{DynamicResource BrandSoftBrush}" CornerRadius="9"><Path Data="{StaticResource IconShield}" Style="{StaticResource IconStyle}" Width="18" Height="18" Stroke="{DynamicResource BrandBrush}"/></Border>
                  <StackPanel Margin="10,0,0,0"><TextBlock Text="随包发行资料" Style="{StaticResource KickerText}"/><TextBlock Text="许可与来源" Style="{StaticResource H2Text}" Margin="0,2,0,0"/></StackPanel>
                </StackPanel>
                <Border Style="{StaticResource DividerStyle}" Margin="0,11,0,10"/>
                <DockPanel Margin="0,0,0,12">
                  <Button x:Name="OpenLicensesFolder" DockPanel.Dock="Right" Content="打开许可资料文件夹" Style="{StaticResource QuietButton}"/>
                  <StackPanel><TextBlock Text="程序版本" Style="{StaticResource TinyText}"/><TextBlock x:Name="VersionText" Text="{Binding AppVersion}" Style="{StaticResource H3Text}"/></StackPanel>
                </DockPanel>
                <TextBlock Text="组件许可与版权文件" Style="{StaticResource H3Text}" Margin="0,0,0,5"/>
                <TextBlock Text="各家原始文件独立随包保留。点击清单项，打开对应文件夹查看原文。" Style="{StaticResource SmallText}" Margin="0,0,0,10"/>
                <StackPanel x:Name="LicenseFilesPanel"/>
              </StackPanel>
            </Border>
            <Border x:Name="AboutPanel" Style="{StaticResource PanelStyle}" Visibility="Collapsed" Margin="0,8,0,0">
              <StackPanel>
                <TextBlock Text="原神副本扫描器" Style="{StaticResource H2Text}"/>
                <TextBlock x:Name="AboutVersionText" Text="{Binding AppVersion, StringFormat=版本：{0}}" Style="{StaticResource SmallText}" Margin="0,6,0,0"/>
                <TextBlock Text="记录每次收获，方便整理与回看。" Style="{StaticResource BodyText}" Margin="0,6,0,16"/>
                <TextBlock Text="一款面向原神副本奖励与圣遗物详情的本地识别工具。支持整趟扫描、单卡识别和横排拼图，将识别结果与图片整理到 Excel，并提供任务记录、学习数据和产出空间管理。" Style="{StaticResource BodyText}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"/>
                <TextBlock Text="本项目为非官方工具，与原神及其权利人无隶属或背书关系。游戏名称及相关素材的权利归各自权利人所有。" Style="{StaticResource SmallText}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                <Border Style="{StaticResource DividerStyle}" Margin="0,18,0,14"/>
                <TextBlock Text="项目主页" Style="{StaticResource KickerText}"/>
                <Button x:Name="OpenProjectHome" Content="https://github.com/DrMoMing/GenshinRewardScanner" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,7,0,0" ToolTip="在默认浏览器打开项目主页"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Grid x:Name="ModalLayer" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="50">
      <Rectangle Fill="#99000000"/>
      <Border Width="520" MaxHeight="620" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="16" Padding="20"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <Grid><StackPanel><TextBlock x:Name="ModalKicker" Text="确认操作" Style="{StaticResource KickerText}"/><TextBlock x:Name="ModalTitle" Text="确认操作" Style="{StaticResource H2Text}" Margin="0,2,0,0"/><TextBlock x:Name="ModalDescription" Style="{StaticResource SmallText}" Margin="0,3,0,0"/></StackPanel><Button x:Name="ModalClose" Style="{StaticResource IconButton}" Content="×" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid>
          <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"><TextBlock x:Name="ModalBody" Style="{StaticResource BodyText}"/></ScrollViewer>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="ModalCancel" Style="{StaticResource QuietButton}" Content="取消" Margin="0,0,8,0"/><Button x:Name="ModalConfirm" Style="{StaticResource DangerButton}" Content="确认"/></StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Border x:Name="Toast" Grid.RowSpan="2" MaxWidth="680" Background="#F7FBF8" BorderBrush="#BFD8CB" BorderThickness="1" CornerRadius="8" Padding="12,8"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" Visibility="Collapsed" Panel.ZIndex="60">
      <TextBlock x:Name="ToastText" FontSize="10.5" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap" MaxWidth="620"/>
    </Border>
  </Grid>
</Window>

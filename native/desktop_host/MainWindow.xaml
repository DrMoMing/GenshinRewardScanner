                  <Border Style="{StaticResource DividerStyle}"/>
                  <ScrollViewer x:Name="BatchScroll" MaxHeight="255" VerticalScrollBarVisibility="Auto" Margin="0,0,0,0"><ItemsControl x:Name="BatchList" ItemTemplate="{StaticResource BatchTemplate}"/></ScrollViewer>
                  <Border Style="{StaticResource DividerStyle}" Margin="0,4,0,9"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding SelectionSummary}" FontSize="10.5" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectionHint}" Style="{StaticResource TinyText}" Margin="0,2,0,0"/></StackPanel><Button Grid.Column="1" x:Name="PreviewCleanup" Style="{StaticResource DangerButton}" HorizontalAlignment="Right" IsEnabled="{Binding SelectionCanClean}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconTrash}" Style="{StaticResource IconStyle}" Width="13" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="预览清理" Margin="5,0,0,0"/></StackPanel></Button><StackPanel Grid.Column="1" x:Name="ProductActions" HorizontalAlignment="Right" Visibility="Collapsed"><WrapPanel x:Name="ProductButtons" HorizontalAlignment="Right"><Button x:Name="ExportBatchJson" Style="{StaticResource QuietButton}" Content="导出产物JSON" IsEnabled="{Binding SelectionCanClean}" Margin="0,0,6,0"/><Button x:Name="ConvertSelected" Style="{StaticResource QuietButton}" Content="转 Excel" IsEnabled="{Binding SelectionCanClean}"/></WrapPanel><TextBlock x:Name="ProductStatus" Style="{StaticResource SmallText}" Foreground="#43515D" HorizontalAlignment="Right" Margin="0,4,0,0" Visibility="Collapsed"/></StackPanel></Grid>
                </StackPanel>
              </Border>

              <StackPanel x:Name="SpaceSide" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Top">
                <Border x:Name="ProtectionPanel" Style="{StaticResource PanelStyle}">
                  <StackPanel><Grid><StackPanel><TextBlock Text="不可清理" Style="{StaticResource KickerText}"/><TextBlock Text="受保护内容" Style="{StaticResource H2Text}" Margin="0,2,0,0"/></StackPanel><Path Data="{StaticResource IconShield}" Style="{StaticResource IconStyle}" Width="18" Height="18" Stroke="{DynamicResource BrandBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid>
                    <StackPanel Margin="0,9,0,0">
                      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource IconFileSheet}" Style="{StaticResource IconStyle}" Width="14" Height="14" Stroke="{DynamicResource BrandBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="用户工作簿" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="扫描结果正本，仅在用户明确操作时处理。" Style="{StaticResource TinyText}" Margin="0,1,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Space.ProtectWorkbook}" FontSize="8.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top"/></Grid>
                      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource IconDatabase}" Style="{StaticResource IconStyle}" Width="14" Height="14" Stroke="{DynamicResource InfoBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="保存待确认的结果" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="保存确认后，任务内 JSON 可随任务清理。" Style="{StaticResource TinyText}" Margin="0,1,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="" FontSize="8.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top"/></Grid>
                      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource IconSparkles}" Style="{StaticResource IconStyle}" Width="14" Height="14" Stroke="#7C719B"/><StackPanel Grid.Column="1"><TextBlock Text="学习成果" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="累积的标注与定位数据。" Style="{StaticResource TinyText}" Margin="0,1,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Space.ProtectLearning}" FontSize="8.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top"/></Grid>
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{StaticResource IconClock}" Style="{StaticResource IconStyle}" Width="14" Height="14" Stroke="{DynamicResource AccentBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="正在使用批次" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="被当前任务、识别或学习队列占用的截图不可勾选。" Style="{StaticResource TinyText}" Margin="0,1,0,0"/></StackPanel></Grid>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border x:Name="AutoPanel" Style="{StaticResource PanelStyle}" Margin="0,10,0,0"><StackPanel><Grid><StackPanel><TextBlock Text="独立策略" Style="{StaticResource KickerText}"/><TextBlock Text="自动清理" Style="{StaticResource H2Text}" Margin="0,2,0,0"/></StackPanel><ToggleButton x:Name="AutoCleanToggle" Style="{StaticResource SwitchStyle}" IsChecked="{Binding Settings.AutoCleanup, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid><TextBlock Text="{Binding AutoStateText}" Style="{StaticResource TinyText}" Margin="0,5,0,0"/><StackPanel x:Name="AutoDetail" Margin="0,7,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="AutoBatches" Style="{StaticResource SegmentButton}" Content="按批次数"/><Button x:Name="AutoDays" Style="{StaticResource SegmentButton}" Content="按保留天数" Margin="3,0,0,0"/></StackPanel><StackPanel x:Name="AutoBatchesOption" Orientation="Horizontal" Margin="0,7,0,0"><TextBlock Text="保留最近" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><Button x:Name="AutoKeepMinus" Style="{StaticResource TextButton}" Content="−" Width="20" Height="24"/><TextBox x:Name="AutoKeepBatches" Style="{StaticResource InputStyle}" Text="{Binding Settings.KeepBatches, UpdateSourceTrigger=LostFocus}" Width="38" Height="25" Padding="4,2" TextAlignment="Center" FontSize="9.5"/><Button x:Name="AutoKeepPlus" Style="{StaticResource TextButton}" Content="+" Width="20" Height="24"/><TextBlock Text="个批次" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="3,0,0,0"/></StackPanel><StackPanel x:Name="AutoDaysOption" Orientation="Horizontal" Margin="0,7,0,0" Visibility="Collapsed"><TextBlock Text="保留最近" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><ComboBox x:Name="AutoKeepDays" Style="{StaticResource ComboStyle}" Width="72" Height="27" ItemsSource="{Binding KeepDayOptions}" SelectedItem="{Binding Settings.KeepDays, Mode=TwoWay}" Margin="6,0,3,0"/><TextBlock Text="天" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></StackPanel><TextBlock Text="勾选要自动清理的资料" Style="{StaticResource TinyText}" Margin="0,6,0,2"/><WrapPanel><CheckBox x:Name="auto_images" Content="图片" Style="{StaticResource AutoCategoryCheckStyle}"/><CheckBox x:Name="auto_results" Content="结果 JSON" Style="{StaticResource AutoCategoryCheckStyle}"/><CheckBox x:Name="auto_diagnostics" Content="日志与诊断" Style="{StaticResource AutoCategoryCheckStyle}"/></WrapPanel><TextBlock Text="{Binding AutoHint}" Style="{StaticResource TinyText}" Margin="0,5,0,0"/></StackPanel><TextBlock Text="自动清理在停止监听且任务、学习队列空闲后执行。" Style="{StaticResource TinyText}" Margin="0,6,0,0"/></StackPanel></Border>
                <Border x:Name="ExportPanel" Style="{StaticResource PanelStyle}" Margin="0,10,0,0"><StackPanel><Grid><StackPanel><TextBlock Text="问题定位" Style="{StaticResource KickerText}"/><TextBlock Text="错误导出" Style="{StaticResource H2Text}" Margin="0,2,0,0"/></StackPanel><Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="5" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="失败 / 异常" FontSize="8" Foreground="{DynamicResource DangerBrush}"/></Border></Grid><TextBlock Text="显示失败或异常任务，默认定位最近一次错误。" Style="{StaticResource TinyText}" Margin="0,5,0,0"/><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="错误记录" FontSize="8.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><local:ManualScrollComboBox x:Name="ExportIssueSelect" Grid.Column="1" Style="{StaticResource ComboStyle}" Height="28" ItemsSource="{Binding Issues}" SelectedItem="{Binding SelectedIssue, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" FontSize="9.5" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></local:ManualScrollComboBox></Grid><TextBlock Text="{Binding ExportSelectionNote}" Style="{StaticResource TinyText}" Margin="0,5,0,0"/><Button x:Name="PreviewExport" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,7,0,0" Content="查看导出范围" IsEnabled="{Binding ExportEnabled}"/><TextBlock Text="确认范围后创建 ZIP；取消不会写入任何文件。" Style="{StaticResource TinyText}" Margin="0,6,0,0"/></StackPanel></Border>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,24">
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Border Width="20" Height="1" Background="{DynamicResource BrandBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="偏好设置" Style="{StaticResource KickerText}"/></StackPanel><TextBlock x:Name="SettingsPageTitle" Text="设置" Style="{StaticResource H1Text}" Margin="0,5,0,2"/><TextBlock Text="快捷键、浮窗、性能显示与提示音。修改自动保存到本机设置。" Style="{StaticResource BodyText}"/></StackPanel></Grid>
            <Border Background="{DynamicResource InfoSoftBrush}" BorderBrush="#CCDEE6" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,14,0,0"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconInfo}" Style="{StaticResource IconStyle}" Width="13" Height="13" Stroke="{DynamicResource InfoBrush}"/><TextBlock Text="修改会自动保存；快捷键可在本页直接录入。" FontSize="9" Foreground="{DynamicResource InfoBrush}" Margin="6,0,0,0"/></StackPanel></Border>
            <Grid x:Name="SettingsGrid" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SettingsLeftColumn" Width="1.02*"/><ColumnDefinition x:Name="SettingsRightColumn" Width="0.98*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <Border x:Name="ShortcutsPanel" Style="{StaticResource PanelStyle}"><StackPanel><Grid><StackPanel><TextBlock Text="六组快捷键" Style="{StaticResource KickerText}"/><TextBlock Text="任务与操作" Style="{StaticResource H2Text}" Margin="0,2,0,0"/></StackPanel><Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="5" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="系统级快捷键" FontSize="8" Foreground="{DynamicResource MutedBrush}"/></Border></Grid><StackPanel Margin="0,8,0,0">
                  <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="整趟扫描" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="按所选星级执行完整任务" Style="{StaticResource TinyText}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="ShortcutFullFailure" Text="注册失败" Foreground="{DynamicResource DangerBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,8,0" Visibility="Collapsed"/><TextBox x:Name="ShortcutFullBox" Style="{StaticResource ShortcutInputStyle}" Text="{Binding Settings.ShortcutFull, Mode=OneWay}"/></StackPanel></Grid>
                  <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="单卡识别" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="识别当前详情画面" Style="{StaticResource TinyText}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="ShortcutSingleFailure" Text="注册失败" Foreground="{DynamicResource DangerBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,8,0" Visibility="Collapsed"/><TextBox x:Name="ShortcutSingleBox" Style="{StaticResource ShortcutInputStyle}" Text="{Binding Settings.ShortcutSingle, Mode=OneWay}"/></StackPanel></Grid>
                  <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="拼图识别" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="合成横排拼图后识别" Style="{StaticResource TinyText}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="ShortcutPuzzleFailure" Text="注册失败" Foreground="{DynamicResource DangerBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,8,0" Visibility="Collapsed"/><TextBox x:Name="ShortcutPuzzleBox" Style="{StaticResource ShortcutInputStyle}" Text="{Binding Settings.ShortcutPuzzle, Mode=OneWay}"/></StackPanel></Grid>
                  <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="中止当前任务" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="保留监听与已加载模型" Style="{StaticResource TinyText}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="ShortcutAbortFailure" Text="注册失败" Foreground="{DynamicResource DangerBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,8,0" Visibility="Collapsed"/><TextBox x:Name="ShortcutAbortBox" Style="{StaticResource ShortcutInputStyle}" Text="{Binding Settings.ShortcutAbort, Mode=OneWay}"/></StackPanel></Grid>
                  <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="停止监听" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="停止任务快捷键，不退出应用" Style="{StaticResource TinyText}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="ShortcutStopFailure" Text="注册失败" Foreground="{DynamicResource DangerBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,8,0" Visibility="Collapsed"/><TextBox x:Name="ShortcutStopBox" Style="{StaticResource ShortcutInputStyle}" Text="{Binding Settings.ShortcutStop, Mode=OneWay}"/></StackPanel></Grid>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="浮窗锁定 / 编辑" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="切换鼠标穿透与编辑状态" Style="{StaticResource TinyText}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="ShortcutOverlayFailure" Text="注册失败" Foreground="{DynamicResource DangerBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,8,0" Visibility="Collapsed"/><TextBox x:Name="ShortcutOverlayBox" Style="{StaticResource ShortcutInputStyle}" Text="{Binding Settings.ShortcutOverlay, Mode=OneWay}"/></StackPanel></Grid>

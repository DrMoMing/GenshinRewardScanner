      <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
      <Setter Property="BorderBrush" Value="#E8C0B8"/>
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
      <Setter Property="Height" Value="36"/>
    </Style>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="10,0"/>
    </Style>
    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandSoftBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedOnDarkBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                <Setter Property="Foreground" Value="{DynamicResource InkOnDarkBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#3AFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    </Style>

    <Style x:Key="NavItemStyle" TargetType="RadioButton">
      <Setter Property="Height" Value="50"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Padding" Value="10,0,8,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <Grid>
                <Border x:Name="Accent" Width="3" Background="#5BC49E" CornerRadius="2"
                        HorizontalAlignment="Left" Margin="-10,8,0,8" Opacity="0"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#14261F"/>
                <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#20352D"/>
                <Setter TargetName="Accent" Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="#F0F7F3"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
      <Setter Property="Height" Value="28"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Padding" Value="9,0"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    </Style>
    <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Height" Value="27"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
    <Style x:Key="SubTabButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="13,0"/>
    </Style>

    <Style x:Key="StarChipStyle" TargetType="ToggleButton">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="9,0"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandSoftBrush}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#9CC4B0"/>
                <Setter Property="Foreground" Value="{DynamicResource BrandDeepBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SwitchStyle" TargetType="ToggleButton">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Track" Width="34" Height="20" Background="#CFD8D1" CornerRadius="10">
              <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrandBrush}"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BatchCheckStyle" TargetType="CheckBox">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="16" Height="16" Background="{DynamicResource SurfaceRaisedBrush}"
                      BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                <Path x:Name="Check" Data="{StaticResource IconCheck}" Width="10" Height="10"
                      Stroke="{DynamicResource WhiteBrush}" StrokeThickness="2" Stretch="Uniform" Opacity="0"/>
              </Border>
              <ContentPresenter x:Name="Caption" VerticalAlignment="Center" Margin="5,0,0,0" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="HasContent" Value="False">
                <Setter TargetName="Caption" Property="Visibility" Value="Collapsed"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrandBrush}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                <Setter TargetName="Check" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Box" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AutoCategoryCheckStyle" TargetType="CheckBox" BasedOn="{StaticResource BatchCheckStyle}">
      <Setter Property="Width" Value="Auto"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style x:Key="InputStyle" TargetType="TextBox">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CaretBrush" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="SelectionBrush" Value="#B9DED1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ShortcutInputStyle" TargetType="TextBox" BasedOn="{StaticResource InputStyle}">
      <Setter Property="InputMethod.IsInputMethodEnabled" Value="False"/>
      <Setter Property="Width" Value="116"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
    </Style>

    <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandSoftBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrandDeepBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ComboStyle" TargetType="ComboBox">
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1" CornerRadius="8">
                      <Grid>
                        <ContentPresenter Margin="9,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"/>
                        <Path Data="{StaticResource IconChevronDown}" Width="12" Height="12" Stretch="Uniform"
                              Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" HorizontalAlignment="Right" Margin="0,0,9,0"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" StaysOpen="False">
                <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, ElementName=Toggle}">
                  <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
                    <StackPanel IsItemsHost="True" Margin="4"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RangeSlider" TargetType="Slider">
      <Setter Property="Height" Value="22"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid>
              <Border Height="4" Background="{DynamicResource LineBrush}" CornerRadius="2" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track" VerticalAlignment="Center"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{DynamicResource BrandBrush}" Height="4" CornerRadius="2"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="14" Height="14">
                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource BrandBrush}" Stroke="White" StrokeThickness="2"/></ControlTemplate></Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" Height="4"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ProgressStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="StatusBoardStyle" TargetType="Border" BasedOn="{StaticResource PanelStyle}">
      <Setter Property="Padding" Value="0"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Runtime.Tone}" Value="progress">
          <Setter Property="Background" Value="#F7FAF7"/><Setter Property="BorderBrush" Value="#CBDDD2"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Runtime.Tone}" Value="ready">
          <Setter Property="Background" Value="#F1F8F4"/><Setter Property="BorderBrush" Value="#B7D8C9"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Runtime.Tone}" Value="running">
          <Setter Property="Background" Value="#F4FAF6"/><Setter Property="BorderBrush" Value="#A8D1BD"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Runtime.Tone}" Value="success">
          <Setter Property="Background" Value="#F1F8F3"/><Setter Property="BorderBrush" Value="#C7E0D3"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Runtime.Tone}" Value="failure">
          <Setter Property="Background" Value="#FCF4F1"/><Setter Property="BorderBrush" Value="#E7C2B9"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Runtime.Tone}" Value="nogame">
          <Setter Property="Background" Value="#FBF8F0"/><Setter Property="BorderBrush" Value="#E4D4AE"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="LogItemTemplate">
      <Grid Margin="0,0,0,7">
        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
        <Border Grid.Column="1" Width="5" Height="5" CornerRadius="3" Background="{Binding ToneBrush}" VerticalAlignment="Top" Margin="4,5,0,0"/>
        <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource SmallText}" Foreground="{DynamicResource InkSoftBrush}"/>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="BatchTemplate">
      <Border Background="{Binding RowBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="2,10">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
          <CheckBox Grid.Column="0" Style="{StaticResource BatchCheckStyle}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                    IsEnabled="{Binding CanSelect}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Margin="2,0,10,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Title}" Style="{StaticResource H3Text}" FontSize="10.5"/>
              <Border Background="{DynamicResource WarnSoftBrush}" CornerRadius="4" Padding="5,1" Margin="7,0,0,0">
                <Border.Style><Style TargetType="Border"><Style.Triggers>
                  <DataTrigger Binding="{Binding StatusText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                  <DataTrigger Binding="{Binding StatusText}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers></Style></Border.Style>
                <TextBlock Text="{Binding StatusText}" FontSize="8" Foreground="#A23F32"/>
              </Border>
              <Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="4" Padding="5,1" Margin="7,0,0,0">
                <Border.Style><Style TargetType="Border"><Style.Triggers>
                  <DataTrigger Binding="{Binding Stars}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                  <DataTrigger Binding="{Binding Stars}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers></Style></Border.Style>
                <TextBlock Text="{Binding Stars}" FontSize="8" Foreground="{DynamicResource MutedBrush}"/>
              </Border>
              <Border Background="{DynamicResource WarnSoftBrush}" CornerRadius="4" Padding="5,1" Margin="7,0,0,0"
                      Visibility="{Binding Protected, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource IconLock}" Width="9" Height="9" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"/>
                  <TextBlock Text="{Binding Reason}" FontSize="8" Foreground="{DynamicResource AccentBrush}" Margin="3,0,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Meta}" Style="{StaticResource TinyText}" Margin="0,3,0,0"/>
            <WrapPanel><Button Tag="folder" Content="打开所在位置" Style="{StaticResource TextButton}" Visibility="{Binding OpenFolder, Converter={StaticResource BoolVis}}"/><Button Tag="record" Content="任务日志目录" Margin="8,0,0,0" Style="{StaticResource TextButton}" Visibility="{Binding OpenRecord, Converter={StaticResource BoolVis}}"/></WrapPanel>
            <TextBlock Text="{Binding Reason}" Style="{StaticResource TinyText}" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"
                       Visibility="{Binding Protected, Converter={StaticResource BoolVis}}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock Text="{Binding SizeText}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding StateText}" FontSize="8" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
          </StackPanel>
          <Path Grid.Column="3" Data="{StaticResource IconLock}" Width="12" Height="12" Stretch="Uniform"
                Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.8" VerticalAlignment="Center"
                Visibility="{Binding Protected, Converter={StaticResource BoolVis}}"/>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="SegmentLegendTemplate">
      <StackPanel Orientation="Horizontal" Margin="0,0,14,5">
        <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Label}" FontSize="8.5" Foreground="{DynamicResource MutedBrush}" Margin="5,0,0,0"/>
        <TextBlock Text="{Binding SizeText}" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource InkSoftBrush}" Margin="4,0,0,0"/>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Single native title bar. WindowChrome owns drag, double-click and
         native resize; the buttons below opt back into hit testing. -->
    <Border Grid.Row="0" Background="{DynamicResource TitlebarGradient}" BorderBrush="#38000000" BorderThickness="0,0,0,1">
      <Grid Margin="16,0,14,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="28" Height="28" Background="{DynamicResource BrandMarkGradient}" BorderBrush="#33BDEBDA" BorderThickness="1" CornerRadius="9">
            <Path Data="{StaticResource IconLogo}" Width="18" Height="18" Stretch="Uniform" Stroke="#D9F2E7" StrokeThickness="1.6" StrokeLineJoin="Round"/>
          </Border>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
            <TextBlock Text="原神副本扫描器" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkOnDarkBrush}"/>
            <Border Background="#14FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="6,2" Margin="7,0,0,0">
              <TextBlock Text="桌面版" FontSize="9" Foreground="{DynamicResource MutedOnDarkBrush}"/>
            </Border>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="TitlebarContext" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
          <TextBlock Text="{Binding CurrentPageTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#C4D3CB"/>
          <Rectangle Width="1" Height="15" Fill="#20FFFFFF" Margin="9,0"/>
          <TextBlock Text="素材识别与工作簿记录" FontSize="11.5" Foreground="#83978C"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="WindowMinimize" Style="{StaticResource WindowButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="最小化">
            <Path Data="{StaticResource IconMinus}" Style="{StaticResource IconStyle}" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button x:Name="WindowMaximize" Style="{StaticResource WindowButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="最大化 / 还原" Margin="4,0,0,0">
            <Path Data="{StaticResource IconMaximize}" Style="{StaticResource IconStyle}" Width="13" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button x:Name="WindowClose" Style="{StaticResource WindowCloseButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="关闭" Margin="8,0,0,0">
            <Path Data="{StaticResource IconX}" Style="{StaticResource IconStyle}" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="BodyGrid" Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="{DynamicResource SidebarGradient}" BorderBrush="{DynamicResource SidebarLineBrush}" BorderThickness="0,0,1,0">
        <Grid x:Name="SidebarContent" Margin="13,18,13,14">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock Text="工作台" FontSize="9" Foreground="{DynamicResource SidebarMutedBrush}" Margin="4,0,0,10"/>
            <RadioButton x:Name="NavScan" Style="{StaticResource NavItemStyle}" GroupName="MainNav" IsChecked="True" Tag="scan">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconScan}" Style="{StaticResource IconStyle}" Width="17" Height="17" Margin="0,0,10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <StackPanel><TextBlock Text="扫描主页" FontSize="12.5" FontWeight="SemiBold"/><TextBlock Text="状态 · 任务 · 日志" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Opacity="0.7"/></StackPanel>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavSpace" Style="{StaticResource NavItemStyle}" GroupName="MainNav" Tag="space">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconLayers}" Style="{StaticResource IconStyle}" Width="17" Height="17" Margin="0,0,10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <StackPanel><TextBlock Text="产出 / 空间" FontSize="12.5" FontWeight="SemiBold"/><TextBlock Text="批次 · 保护 · 清理" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Opacity="0.7"/></StackPanel>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItemStyle}" GroupName="MainNav" Tag="settings">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconSliders}" Style="{StaticResource IconStyle}" Width="17" Height="17" Margin="0,0,10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <StackPanel><TextBlock Text="设置" FontSize="12.5" FontWeight="SemiBold"/><TextBlock Text="快捷键 · 浮窗 · 声音" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Opacity="0.7"/></StackPanel>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavHelp" Style="{StaticResource NavItemStyle}" GroupName="MainNav" Tag="help">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconBook}" Style="{StaticResource IconStyle}" Width="17" Height="17" Margin="0,0,10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <StackPanel><TextBlock Text="教程 / 许可 / 关于" FontSize="12.5" FontWeight="SemiBold"/><TextBlock Text="使用说明与项目信息" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Opacity="0.7"/></StackPanel>
              </StackPanel>
            </RadioButton>
          </StackPanel>

          <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
            <Border Background="#17FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="12" Padding="11,10">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Border Width="26" Height="26" Background="#20352D" CornerRadius="8">
                    <Path Data="{StaticResource IconTarget}" Style="{StaticResource IconStyle}" Width="14" Height="14" Stroke="#8EE0C2"/>
                  </Border>
                  <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="运行状态" FontSize="9.5" Foreground="{DynamicResource SidebarMutedBrush}"/>
                    <TextBlock Text="{Binding HostCardState}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource InkOnDarkBrush}"/>
                  </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding HostCardDetail}" FontSize="10" Foreground="{DynamicResource SidebarMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="15"/>
                <TextBlock Text="状态与操作由扫描器服务提供。" FontSize="9" Foreground="#70857A" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="13"/>
              </StackPanel>
            </Border>
            <Grid Margin="3,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{Binding HostDotBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding HostFooter}" FontSize="9.5" Foreground="{DynamicResource SidebarMutedBrush}" Margin="6,0,0,0"/>
              </StackPanel>
              <Button x:Name="UninstallApp" Grid.Column="1" Content="卸载" FontSize="9.5" Padding="5,3" Margin="5,0,0,0" Foreground="{DynamicResource SidebarMutedBrush}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="退出扫描器并启动卸载；可选择保留或清除数据"/>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Pages: static visual tree; snapshots only update bindings, never rebuild pages. -->
      <Grid Grid.Column="1" Background="{DynamicResource BgBrush}">
        <ScrollViewer x:Name="PageScan" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,24">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal"><Border Width="20" Height="1" Background="{DynamicResource BrandBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="扫描工作台" Style="{StaticResource KickerText}"/></StackPanel>
                <TextBlock x:Name="ScanPageTitle" Text="扫描主页" Style="{StaticResource H1Text}" Margin="0,5,0,2"/>
                <TextBlock Text="设置识别路数与输出，准备就绪后，在游戏内按快捷键执行任务。" Style="{StaticResource BodyText}"/>
              </StackPanel>
              <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource IconMonitor}" Style="{StaticResource IconStyle}" Width="13" Height="13" Stroke="{DynamicResource MutedBrush}"/>
                  <TextBlock Text="{Binding HostBadge}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Margin="5,0,0,0"/>
                </StackPanel>
              </Border>
            </Grid>

            <Border Background="{DynamicResource WarnSoftBrush}" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
              <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Runtime.ResolutionWarning}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
              <TextBlock Text="{Binding Runtime.ResolutionWarning}" TextWrapping="Wrap" Foreground="#805916"/>
            </Border>
            <Border x:Name="ShortcutWarningBanner" Background="{DynamicResource WarnSoftBrush}" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
              <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Runtime.ShortcutWarning}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
              <TextBlock Text="{Binding Runtime.ShortcutWarning}" TextWrapping="Wrap" Foreground="#805916"/>
            </Border>
            <Border x:Name="StatusBoard" Style="{StaticResource StatusBoardStyle}" Margin="0,16,0,0">
              <Grid>
                <Border Width="4" Background="{Binding Runtime.ToneBrush}" CornerRadius="14,0,0,14" HorizontalAlignment="Left"/>
                <StackPanel x:Name="StatusContent" Margin="20,18,20,14">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                      <Border x:Name="StateIconBorder" Width="46" Height="46" Background="{Binding Runtime.ToneSoftBrush}" CornerRadius="14" BorderBrush="{Binding Runtime.ToneBrush}" BorderThickness="1" VerticalAlignment="Top">
                        <Path x:Name="StateIconPath" Data="{Binding Runtime.StateGlyph}" Width="23" Height="23" Stretch="Uniform" Stroke="{Binding Runtime.ToneBrush}" StrokeThickness="1.7" StrokeLineJoin="Round"/>
                      </Border>
                      <StackPanel Margin="11,1,0,0">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="5" Height="5" Fill="{Binding Runtime.ToneBrush}" VerticalAlignment="Center"/>
                          <TextBlock Text="当前状态" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="5,0,0,0"/>
                          <Border Background="{Binding Runtime.ToneSoftBrush}" CornerRadius="5" Padding="5,1" Margin="7,0,0,0">
                            <TextBlock Text="{Binding Runtime.Chip}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding Runtime.ToneBrush}"/>
                          </Border>
                        </StackPanel>
                        <TextBlock x:Name="StatusTitleText" Text="{Binding Runtime.Title}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,2,0,0"/>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                      <Button x:Name="PrimaryAction" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding Runtime.PrimaryEnabled}">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPlay}" Style="{StaticResource IconStyle}" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="{Binding Runtime.PrimaryLabel}" Margin="6,0,0,0"/></StackPanel>
                      </Button>
                      <Button x:Name="AbortAction" Style="{StaticResource DangerButton}" Margin="7,0,0,0" Visibility="{Binding Runtime.AbortVisible, Converter={StaticResource BoolVis}}" IsEnabled="{Binding Runtime.AbortEnabled}">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconStop}" Style="{StaticResource IconStyle}" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="中止任务" Margin="5,0,0,0"/></StackPanel>
                      </Button>
                      <Button x:Name="CheckMemory" Style="{StaticResource QuietButton}" Margin="7,0,0,0" IsEnabled="{Binding Runtime.CheckEnabled}">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconActivity}" Style="{StaticResource IconStyle}" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="检测内存" Margin="5,0,0,0"/></StackPanel>
                      </Button>
                      <Button x:Name="StopAction" Style="{StaticResource QuietButton}" Margin="7,0,0,0" IsEnabled="{Binding Runtime.StopEnabled}">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPower}" Style="{StaticResource IconStyle}" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="停止监听" Margin="5,0,0,0"/></StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>

                  <Border x:Name="HomeShortcutsBorder" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,14,0,0">
                    <WrapPanel x:Name="HomeShortcutsPanel" Orientation="Horizontal">
                      <TextBlock Text="切回游戏后按键" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,16,6"/>
                      <StackPanel Orientation="Horizontal" Margin="0,0,16,6"><TextBlock Text="整趟扫描" FontSize="11" Foreground="{DynamicResource InkSoftBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/><Border Style="{StaticResource KbdBox}"><TextBlock Text="{Binding Runtime.ShortcutFull}" Style="{StaticResource KbdText}"/></Border></StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,16,6"><TextBlock Text="单卡识别" FontSize="11" Foreground="{DynamicResource InkSoftBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/><Border Style="{StaticResource KbdBox}"><TextBlock Text="{Binding Runtime.ShortcutSingle}" Style="{StaticResource KbdText}"/></Border></StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,16,6"><TextBlock Text="横排拼图" FontSize="11" Foreground="{DynamicResource InkSoftBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/><Border Style="{StaticResource KbdBox}"><TextBlock Text="{Binding Runtime.ShortcutPuzzle}" Style="{StaticResource KbdText}"/></Border></StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="中止任务" FontSize="11" Foreground="{DynamicResource InkSoftBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/><Border Style="{StaticResource KbdBox}"><TextBlock Text="{Binding Runtime.ShortcutAbort}" Style="{StaticResource KbdText}"/></Border></StackPanel>
                    </WrapPanel>
                  </Border>
                  <TextBlock x:Name="StatusDetailText" Text="{Binding Runtime.Detail}" Style="{StaticResource BodyText}" Margin="0,10,0,0" MinHeight="19"/>

                  <Border x:Name="StatusStatsLine" Height="1" Background="{DynamicResource LineBrush}" Margin="0,13,0,0"/>
                  <Grid x:Name="StatusStatsGrid" Margin="0,11,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="快捷键监听" FontSize="9" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Runtime.Listening}" FontSize="14.5" FontWeight="SemiBold" Margin="0,1,0,0"/><TextBlock Text="{Binding Runtime.ListeningSub}" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
                    <Border Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="12,0,0,0"><StackPanel><TextBlock Text="已加载模型" FontSize="9" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Runtime.Models}" FontSize="14.5" FontWeight="SemiBold" Margin="0,1,0,0"/><TextBlock Text="识别模型" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
                    <Border Grid.Column="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="12,0,0,0"><StackPanel><TextBlock Text="请求 / 实际路数" FontSize="9" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Runtime.Lanes}" FontSize="14.5" FontWeight="SemiBold" Margin="0,1,0,0"/><TextBlock Text="{Binding Runtime.LaneSub}" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
                    <Border Grid.Column="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="12,0,0,0"><StackPanel><TextBlock Text="捕获窗口" FontSize="9" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Runtime.Window}" FontSize="14.5" FontWeight="SemiBold" Margin="0,1,0,0"/><TextBlock Text="{Binding Runtime.WindowSub}" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
                  </Grid>

                  <TextBlock x:Name="ParallelSingleProgress" Visibility="Collapsed" Margin="0,10,0,0" Style="{StaticResource BodyText}"/>
                  <StackPanel Visibility="{Binding Runtime.ProgressVisible, Converter={StaticResource BoolVis}}" Margin="0,10,0,0">
                    <Grid><TextBlock Text="{Binding Runtime.ProgressLabel}" FontSize="9" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Runtime.ProgressText}" FontSize="9" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/></Grid>
                    <ProgressBar Style="{StaticResource ProgressStyle}" Margin="0,5,0,0" IsIndeterminate="{Binding Runtime.ProgressIndeterminate}" Value="{Binding Runtime.ProgressValue}"/>
                  </StackPanel>

                  <Grid x:Name="StatusFoot" Margin="0,10,0,0">
                    <TextBlock Text="{Binding Runtime.Hint}" Style="{StaticResource TinyText}" VerticalAlignment="Center"/>
                    <Button x:Name="JumpToLog" Style="{StaticResource TextButton}" Height="20" HorizontalAlignment="Right" Content="查看最近状态  →"/>
                  </Grid>
                </StackPanel>
              </Grid>
            </Border>

            <Grid x:Name="ScanGrid" Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition x:Name="ScanTaskColumn" Width="1.55*"/><ColumnDefinition x:Name="ScanSetupColumn" Width="0.92*"/></Grid.ColumnDefinitions>
              <Border x:Name="ScanTaskPanel" Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,6,0" VerticalAlignment="Top">
                <StackPanel>
                  <Grid><StackPanel><TextBlock Text="识别与性能" Style="{StaticResource KickerText}"/><TextBlock Text="扫描设置" Style="{StaticResource H2Text}" Margin="0,2,0,0"/></StackPanel><Border Background="{DynamicResource BrandSoftBrush}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="{Binding Runtime.TaskSummary}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BrandBrush}"/></Border></Grid>
                  <Border Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,13,0,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="请求路数" FontSize="10.5" FontWeight="SemiBold"/><TextBlock Text="1–4 路" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0" VerticalAlignment="Bottom"/></StackPanel><TextBlock Text="{Binding Runtime.LaneFeatureText}" Style="{StaticResource TinyText}" Margin="0,3,0,0"/></StackPanel>
                      <Border Grid.Column="1" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="3,2">
                        <StackPanel Orientation="Horizontal">
                          <Button x:Name="LaneMinus" Style="{StaticResource TextButton}" Width="24" Height="24" Content="−" FontSize="15" Foreground="{DynamicResource MutedBrush}"/>
                          <TextBlock Text="{Binding Settings.SingleWorkers}" FontSize="11.5" FontWeight="SemiBold" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                          <Button x:Name="LanePlus" Style="{StaticResource TextButton}" Width="24" Height="24" Content="+" FontSize="15" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Border>
                  <Grid Margin="0,12,0,0"><TextBlock Text="星级筛选" FontSize="10.5" FontWeight="SemiBold"/><TextBlock Text="可多选" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="55,1,0,0"/></Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <ToggleButton x:Name="Star5" Style="{StaticResource StarChipStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="★" FontSize="10" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="5 星" Margin="4,0,0,0"/></StackPanel></ToggleButton>
                    <ToggleButton x:Name="Star4" Style="{StaticResource StarChipStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="★" FontSize="10" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="4 星" Margin="4,0,0,0"/></StackPanel></ToggleButton>
                    <ToggleButton x:Name="Star3" Style="{StaticResource StarChipStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="★" FontSize="10" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="3 星" Margin="4,0,0,0"/></StackPanel></ToggleButton>
                    <ToggleButton x:Name="Star2" Style="{StaticResource StarChipStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="★" FontSize="10" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="2 星" Margin="4,0,0,0"/></StackPanel></ToggleButton>
                  </StackPanel>
                  <Border Style="{StaticResource DividerStyle}" Margin="0,13,0,10"/>
                  <Grid><StackPanel><TextBlock Text="横排读字" FontSize="10.5" FontWeight="SemiBold"/><TextBlock Text="拼图任务读取横排文字信息" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/></StackPanel><ToggleButton x:Name="HorizontalToggle" Style="{StaticResource SwitchStyle}" IsChecked="{Binding Settings.RowInfo, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                </StackPanel>
              </Border>

              <Border x:Name="SetupPanel" Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="6,0,0,0" VerticalAlignment="Top">
                <StackPanel>
                  <Grid><StackPanel><TextBlock Text="输出与捕获" Style="{StaticResource KickerText}"/><TextBlock Text="连接设置" Style="{StaticResource H2Text}" Margin="0,2,0,0"/></StackPanel><Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="5" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="启动时校验" FontSize="8" Foreground="{DynamicResource MutedBrush}"/></Border></Grid>
                  <Grid Margin="0,9,0,0"><TextBlock Text="工作簿" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding Settings.WorkbookModeLabel}" FontSize="8.5" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/></Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Button x:Name="WorkbookAuto" Style="{StaticResource SegmentButton}" Content="自动新建"/>
                    <Button x:Name="WorkbookExisting" Style="{StaticResource SegmentButton}" Content="指定工作簿" Margin="3,0,0,0"/>
                  </StackPanel>
                  <Border Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="9,7" Margin="0,7,0,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Path Grid.Column="0" Data="{StaticResource IconFileSheet}" Style="{StaticResource IconStyle}" Width="15" Height="15" Stroke="{DynamicResource BrandBrush}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                      <StackPanel Grid.Column="1"><Grid><TextBox x:Name="WorkbookPathInput" Style="{StaticResource InputStyle}" Text="{Binding Settings.WorkbookPath, UpdateSourceTrigger=LostFocus}" Height="30" Padding="7,3" FontSize="10" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/><TextBlock Text="留空自动新建；或填写 .xlsx 完整路径" FontSize="9.5" Foreground="{DynamicResource FaintBrush}" Margin="9,0,6,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=WorkbookPathInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><TextBlock Text="{Binding Settings.WorkbookMeta}" FontSize="8.5" Foreground="{DynamicResource FaintBrush}" Margin="2,2,0,0"/></StackPanel>
                      <Button x:Name="PickWorkbook" Grid.Column="2" Style="{StaticResource TextButton}" Content="选择" Visibility="{Binding Settings.PickVisible, Converter={StaticResource BoolVis}}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="工作表" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox x:Name="SheetInput" Style="{StaticResource InputStyle}" Text="{Binding Settings.Sheet, UpdateSourceTrigger=LostFocus}" Width="96" Height="27" Padding="6,2" FontSize="10"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="实时显示" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/><ToggleButton x:Name="LiveToggle" Style="{StaticResource SwitchStyle}" IsChecked="{Binding Settings.LiveExcel, Mode=TwoWay}"/></StackPanel></Grid>
                  <Border Style="{StaticResource DividerStyle}" Margin="0,10,0,9"/>
                  <Grid><TextBlock Text="当前捕获窗口" FontSize="10" FontWeight="SemiBold"/><Button x:Name="RefreshWindow" Style="{StaticResource TextButton}" HorizontalAlignment="Right" Content="刷新"/></Grid>
                  <Border Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="8,7" Margin="0,6,0,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Path Grid.Column="0" Data="{StaticResource IconGamepad}" Style="{StaticResource IconStyle}" Width="16" Height="16" Stroke="{DynamicResource BrandBrush}" VerticalAlignment="Top"/>
                      <StackPanel Grid.Column="1"><TextBlock Text="{Binding Runtime.CaptureName}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding Runtime.CaptureMeta}" FontSize="8.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/></StackPanel>
                      <Border Grid.Column="2" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="4" Padding="5,2" VerticalAlignment="Top"><TextBlock Text="{Binding Runtime.CaptureStatus}" FontSize="8" Foreground="{DynamicResource MutedBrush}"/></Border>
                    </Grid>
                  </Border>
                  <TextBlock Text="刷新只重新读取窗口，不开始任务；切换显示模式后建议核对。" Style="{StaticResource TinyText}" Margin="0,7,0,0"/>
                </StackPanel>
              </Border>
            </Grid>

            <Border x:Name="LogPanel" Style="{StaticResource PanelTightStyle}" Margin="0,12,0,0">
              <StackPanel>

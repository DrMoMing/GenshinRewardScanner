        <TextBlock Canvas.Left="38" Canvas.Top="66" Text="实际 2 路　★5 / ★4　监听中" FontSize="10.5" Foreground="#bed3c6"/>
        <Line X1="36" Y1="84" X2="297" Y2="84" Stroke="#60776a" StrokeThickness="1"/>
        <TextBlock Canvas.Left="38" Canvas.Top="101" Text="第 1 次任务已启动" FontSize="12" Foreground="#ffffff"/>
        <TextBlock Canvas.Left="38" Canvas.Top="127" Text="已收到整趟扫描指令" FontSize="12" Foreground="#ffffff"/>

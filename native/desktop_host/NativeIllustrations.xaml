        <TextBlock Canvas.Left="322" Canvas.Top="94" Text="识别后写入" FontSize="10.5" Foreground="#4c6b5a"/>
        <Line X1="329" Y1="121" X2="374" Y2="121" Stroke="#126b56" StrokeThickness="2.5"/>
        <Polygon Points="374,116 383,121 374,126" Fill="#126b56"/>

        <Border Canvas.Left="396" Canvas.Top="22" Width="344" Height="196" Background="#ffffff" BorderBrush="#c7d7cb" BorderThickness="1" CornerRadius="8"/>
        <Rectangle Canvas.Left="396" Canvas.Top="22" Width="344" Height="35" RadiusX="8" RadiusY="8" Fill="#126b56"/>

        <TextBlock Canvas.Left="647" Canvas.Top="99" Text="717" FontSize="11.5" Foreground="#3c5547"/>
        <TextBlock Canvas.Left="409" Canvas.Top="128" Text="圣遗物记录 2" FontSize="11.5" Foreground="#3c5547"/>
        <TextBlock Canvas.Left="528" Canvas.Top="128" Text="攻击力" FontSize="11.5" Foreground="#3c5547"/>
        <TextBlock Canvas.Left="647" Canvas.Top="128" Text="47" FontSize="11.5" Foreground="#3c5547"/>
        <Line X1="396" Y1="87" X2="740" Y2="87" Stroke="#dfe7e0" StrokeThickness="1"/>
        <Line X1="396" Y1="117" X2="740" Y2="117" Stroke="#dfe7e0" StrokeThickness="1"/>
        <Line X1="396" Y1="147" X2="740" Y2="147" Stroke="#dfe7e0" StrokeThickness="1"/>
        <Line X1="518" Y1="57" X2="518" Y2="147" Stroke="#dfe7e0" StrokeThickness="1"/>
        <Line X1="638" Y1="57" X2="638" Y2="147" Stroke="#dfe7e0" StrokeThickness="1"/>
        <Border Canvas.Left="409" Canvas.Top="160" Width="315" Height="38" Background="#e9f1e9" CornerRadius="5">
          <TextBlock Text="本次完整横排拼图" FontSize="11.5" Foreground="#3c5547" HorizontalAlignment="Center" VerticalAlignment="Center"/>

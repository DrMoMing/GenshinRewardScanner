        <Border Canvas.Left="392" Canvas.Top="12" Width="350" Height="200" Background="#263b45" CornerRadius="12"/>

        <TextBlock Canvas.Left="38" Canvas.Top="24" Text="获得横排" FontSize="14" FontWeight="SemiBold" Foreground="#f5faf7"/>
        <TextBlock Canvas.Left="38" Canvas.Top="44" Text="画面完整可见时" FontSize="11" Foreground="#a9bcb2"/>
        <Rectangle Canvas.Left="44" Canvas.Top="64" Width="44" Height="48" RadiusX="3" RadiusY="3" Fill="#6488a9" Stroke="#e5d9bd" StrokeThickness="1"/>
        <Rectangle Canvas.Left="97" Canvas.Top="64" Width="44" Height="48" RadiusX="3" RadiusY="3" Fill="#6488a9" Stroke="#e5d9bd" StrokeThickness="1"/>
        <Rectangle Canvas.Left="150" Canvas.Top="64" Width="44" Height="48" RadiusX="3" RadiusY="3" Fill="#b18652" Stroke="#e5d9bd" StrokeThickness="1"/>
        <Rectangle Canvas.Left="203" Canvas.Top="64" Width="44" Height="48" RadiusX="3" RadiusY="3" Fill="#8d75a5" Stroke="#e5d9bd" StrokeThickness="1"/>
        <Rectangle Canvas.Left="256" Canvas.Top="64" Width="44" Height="48" RadiusX="3" RadiusY="3" Fill="#6488a9" Stroke="#e5d9bd" StrokeThickness="1"/>
        <TextBlock Canvas.Left="60" Canvas.Top="80" Text="♡" FontSize="17" Foreground="#f7f3e9"/>
        <TextBlock Canvas.Left="113" Canvas.Top="80" Text="◎" FontSize="17" Foreground="#f7f3e9"/>
        <TextBlock Canvas.Left="166" Canvas.Top="80" Text="✿" FontSize="17" Foreground="#f7f3e9"/>
        <TextBlock Canvas.Left="219" Canvas.Top="80" Text="✿" FontSize="17" Foreground="#f7f3e9"/>
        <TextBlock Canvas.Left="272" Canvas.Top="80" Text="✿" FontSize="17" Foreground="#f7f3e9"/>
        <TextBlock Canvas.Left="38" Canvas.Top="120" Text="对应任务" FontSize="10" FontWeight="SemiBold" Foreground="#8fa79a"/>
        <Border Canvas.Left="38" Canvas.Top="139" Width="145" Height="24" Background="#314c57" BorderBrush="#43606c" BorderThickness="1" CornerRadius="5">
          <TextBlock Text="整趟扫描" FontSize="11.5" FontWeight="SemiBold" Foreground="#edf6f0" VerticalAlignment="Center" Margin="11,0"/>
        </Border>
        <Border Canvas.Left="191" Canvas.Top="139" Width="145" Height="24" Background="#314c57" BorderBrush="#43606c" BorderThickness="1" CornerRadius="5">
          <TextBlock Text="横排拼图" FontSize="11.5" FontWeight="SemiBold" Foreground="#edf6f0" VerticalAlignment="Center" Margin="11,0"/>
        </Border>
        <TextBlock Canvas.Left="38" Canvas.Top="179" Text="画面条件：获得奖励横排完整可见" FontSize="10.5" Foreground="#a9bcb2"/>

        <TextBlock Canvas.Left="412" Canvas.Top="24" Text="圣遗物详情" FontSize="14" FontWeight="SemiBold" Foreground="#f5faf7"/>
        <TextBlock Canvas.Left="412" Canvas.Top="44" Text="已在游戏中打开详情时" FontSize="11" Foreground="#a9bcb2"/>
        <Border Canvas.Left="418" Canvas.Top="64" Width="294" Height="116" Background="#eee7d9" CornerRadius="4"/>
        <Rectangle Canvas.Left="418" Canvas.Top="64" Width="294" Height="30" RadiusX="4" RadiusY="4" Fill="#b18652"/>
        <TextBlock Canvas.Left="428" Canvas.Top="72" Text="圣遗物详情 · 示意" FontSize="11.5" FontWeight="SemiBold" Foreground="#ffffff"/>
        <TextBlock Canvas.Left="428" Canvas.Top="104" Text="主词条　数值" FontSize="10.5" Foreground="#4b554f"/>
        <Border Canvas.Left="428" Canvas.Top="118" Width="34" Height="19" Background="#3f4449" CornerRadius="4">
          <TextBlock Text="+0" FontSize="10.5" Foreground="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Canvas.Left="428" Canvas.Top="149" Text="· 副词条 + 数值" FontSize="10.5" Foreground="#4b554f"/>
        <TextBlock Canvas.Left="528" Canvas.Top="149" Text="· 副词条 + 数值" FontSize="10.5" Foreground="#4b554f"/>
        <TextBlock Canvas.Left="428" Canvas.Top="166" Text="套装名称" FontSize="10.5" Foreground="#52834f"/>
        <TextBlock Canvas.Left="412" Canvas.Top="192" Text="对应任务：单卡识别" FontSize="10.5" Foreground="#a9bcb2"/>
      </Canvas>
    </Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="ResultDiagram">

diff --git a/source/MaaWin32ControlUnit/Screencap/DomainCaptureHealth.cpp b/source/MaaWin32ControlUnit/Screencap/DomainCaptureHealth.cpp
new file mode 100644
index 0000000..569e58d
--- /dev/null
+++ b/source/MaaWin32ControlUnit/Screencap/DomainCaptureHealth.cpp
@@ -0,0 +1,29 @@
+#include "DomainCaptureHealth.h"
+#include <atomic>
+#ifdef DOMAIN_CAPTURE_TEST_HOOKS
+#include <chrono>
+#include <thread>
+namespace { std::atomic<int> fault_ { 0 }; }
+extern "C" __declspec(dllexport) void __cdecl DomainScannerSetCaptureFault(int fault) { fault_.store(fault); }
+bool DomainCaptureFaultPoint()
+{
+    if (fault_.load() == 2) {
+        for (;;) { std::this_thread::sleep_for(std::chrono::milliseconds(100)); }
+    }
+    return fault_.load() == 1;
+}
+#endif
+
+namespace {
+std::atomic<DomainCaptureObserver> observer_ { nullptr };
+}
+extern "C" __declspec(dllexport) void __cdecl DomainScannerSetCaptureObserver(DomainCaptureObserver observer)
+{
+    observer_.store(observer, std::memory_order_release);
+}
+void DomainCaptureProgress(int stage, std::int64_t frame_time) noexcept
+{
+    if (auto callback = observer_.load(std::memory_order_acquire)) {
+        callback(stage, frame_time);
+    }
+}
diff --git a/source/MaaWin32ControlUnit/Screencap/DomainCaptureHealth.h b/source/MaaWin32ControlUnit/Screencap/DomainCaptureHealth.h
new file mode 100644
index 0000000..eece60d
--- /dev/null
+++ b/source/MaaWin32ControlUnit/Screencap/DomainCaptureHealth.h
@@ -0,0 +1,16 @@
+#pragma once
+#include <cstdint>
+
+// Private, additive DomainScanner hook. No change to existing Maa ABI.
+// 1 init, 2 waiting, 3 frame received, 4 readback, 5 complete,
+// 6 no-frame timeout, 7 session released, 8 ScreenDC acquire,
+// 10 producer FrameArrived signal (not consumer work progress).
+using DomainCaptureObserver = void(__cdecl*)(int, std::int64_t);
+extern "C" __declspec(dllexport) void __cdecl DomainScannerSetCaptureObserver(DomainCaptureObserver observer);
+void DomainCaptureProgress(int stage, std::int64_t frame_time = 0) noexcept;
+#ifdef DOMAIN_CAPTURE_TEST_HOOKS
+extern "C" __declspec(dllexport) void __cdecl DomainScannerSetCaptureFault(int fault);
+bool DomainCaptureFaultPoint();
+#else
+inline bool DomainCaptureFaultPoint() { return false; }
+#endif
